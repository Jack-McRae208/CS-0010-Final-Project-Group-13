   "source": [
    "# Create a ranked table of the top 10 neighborhoods by coverage.\n",
    "top_10 = neighborhoods[[\"hood\", \"coverage\"]].sort_values(\n",
    "    \"coverage\", ascending=False\n",
    ").head(10).round(2).reset_index(drop=True)\n",
    "\n",
    "# Add an Index column to the table."
    "top_10.index += 1\n",
    "top_10.index.name = \"Rank\"\n",
    "\n",
    "top_10"
   ]
